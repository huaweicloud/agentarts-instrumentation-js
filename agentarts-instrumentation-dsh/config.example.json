// AgentArts 观测插件运行配置模板（带注释的 JSONC；运行时读取同目录结构下的 config.json，
// 会剥离 // 与 /* */ 注释）。配置脚本 configure/dsh-agentarts-plugin.(ps1|sh) 会把
// 命令行参数合并写入 ~/.dsh/plugins/agentarts-instrumentation-dsh/config.json。
{
  "version": "1.0.0-rc.5",
  // 总开关：false 时插件加载后不采集、不上报
  "enabled": true,
  // 数据/日志目录（~ 展开为用户主目录；Windows 下的 msys 风格路径也会被归一化）
  "outputDir": "~/.dsh/plugins/agentarts-instrumentation-dsh/data",
  // Agent 名称：写入 gen_ai.agent.name（span 名与资源属性；为空兜底 deepseek-harness）
  "agent_name": "",
  // 用户/租户标识：写入 user.id（为空兜底主机名）
  "user.id": "",
  // 功能开关
  "features": {
    // debug 日志开关（默认关闭；开启后写 DEBUG 级明细到 data/logs/plugin-YYYY-MM-DD.log）
    "debug": false,
    // 采集 trace 的输入/输出消息内容（**默认开启**）。
    // 开启时会上报到 AgentArts 的内容包括：
    //   - 用户消息、助手回复（gen_ai.input/output.messages）
    //   - 系统提示词（gen_ai.system_instructions）
    //   - 工具调用的参数与返回值（gen_ai.tool.call.arguments/result）
    // 若会话中会出现敏感信息（代码、内部文档、凭据等），请设为 false：
    // 关闭后仍上报 span 结构、耗时、token 用量等指标，仅不含上述内容文本。
    "captureMessageContent": true,
    // 串联子 agent trace 到父 trace（默认开启；false 时子 agent trace 独立上报）
    "linkSubagentTrace": true,
    // 日志保留天数：自动删除更早的 plugin-YYYY-MM-DD.log（0 关闭清理）
    "logRetentionDays": 14
  },
  // OpenTelemetry 上报配置（APM 调用链；默认不配置则不上报）
  "otel": {
    // APM（trace）总开关
    "agentarts_agentops_otel_agent_apm_enable": true,
    // ── AgentArts 控制台参数 ──
    "agent_domain_id": "", // 租户/域 ID（domain.id）
    "agentarts_project_id": "", // 项目 ID（projectid 元数据）
    "agent_resource_id": "", // Agent 资源 ID（gen_ai.resource.id）
    // 资源版本不在此配置：统一取运行中的 DSH 版本。
    // ── APM（trace）OTLP gRPC ──
    "agentarts_agentops_apm_token": "", // APM 认证 token（gRPC metadata: authentication）
    // 上报地址不做格式校验，以下写法均可（脚本原样写入，插件侧统一归一化）：
    //   https://apm-access.<region>.myhuaweicloud.com   （生产域名，TLS/443）
    //   apm-access.<region>.myhuaweicloud.com:443       （域名:端口）
    //   10.x.x.x:4317                                   （内网明文 gRPC）
    "agentarts_agentops_apm_exporter_endpoint": ""
  }
}
