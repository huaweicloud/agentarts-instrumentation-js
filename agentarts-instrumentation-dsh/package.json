{
  "name": "agentarts-instrumentation-dsh",
  "version": "1.0.0-rc.5",
  "description": "DSH AgentArts Observation Plugin - 采集 DeepSeek Harness 运行时的trace和metric数据并上报华为云 AgentArts（APM/AOM）",
  "main": "dist/plugin.mjs",
  "type": "module",
  "exports": {
    ".": "./dist/plugin.mjs",
    "./dist/plugin.mjs": "./dist/plugin.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/plugin.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "config.example.json",
    "configure",
    "docs",
    "SECURITY-NOTES.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js",
    "pack:bundle": "node scripts/pack.mjs",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "metrics",
    "opentelemetry",
    "agentarts"
  ],
  "author": "huaweicloud",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huaweicloud/agentarts-instrumentation-js.git",
    "directory": "agentarts-instrumentation-dsh"
  },
  "homepage": "https://github.com/huaweicloud/agentarts-instrumentation-js/tree/main/agentarts-instrumentation-dsh",
  "bugs": {
    "url": "https://github.com/huaweicloud/agentarts-instrumentation-js/issues"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.223.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@types/node": "^20.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
